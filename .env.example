DATABASE_URL="file:./dev.db"
# Add required GLM runtime settings from hosting provider

# Optional server-only OpenAI-compatible model backend (no credentials in Git)
# EAINESY_MODEL_BACKEND=openai-compatible
# EAINESY_MODEL_ENDPOINT=https://model-provider.example/v1/chat/completions
# EAINESY_MODEL_NAME=provider-model-id
# EAINESY_MODEL_API_KEY=obtain-from-secret-store
# Without these settings, EAInesy keeps the original Z.ai SDK backend.

# Explicit server-side allowlist; omitted = legacy backend only.
# EAINESY_ALLOWED_PROVIDERS=zai,openai,gemini,claude,ollama,custom
# EAINESY_OPENAI_MODEL=<api-model-id>
# EAINESY_OPENAI_API_KEY=<server-secret>
# EAINESY_GEMINI_MODEL=<api-model-id>
# EAINESY_GEMINI_API_KEY=<server-secret>
# EAINESY_CLAUDE_MODEL=<api-model-id>
# EAINESY_CLAUDE_API_KEY=<server-secret>
# Ollama: server loopback only, opt in explicitly (never expose to untrusted clients).
# EAINESY_OLLAMA_LOOPBACK_ENABLED=true
# EAINESY_OLLAMA_MODEL=<installed-local-model>
# Model routes are selected by provider ID for each new chat session.
# No automatic provider fallback. A provider outage blocks the turn.
